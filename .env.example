# CMS 生产环境变量配置
#
# 用法：复制为 .env 放到部署目录的上一级 config 目录（deploy.sh 读取 ../config/.env），
# 填入真实值。该文件含密钥，禁止提交到代码仓库。
#
# 注意：Sa-Token 的登录态基于服务端 token + Redis，不再需要
# 原 Shiro 时代的 SHIRO_REMEMBER_ME_CIPHER_KEY，该变量已废弃可直接删除。

# 服务监听端口。deploy.sh 会解析此项用于健康检查（不配置则默认 8080）
SERVER_PORT=8080

# MySQL 配置
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cms?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Redis 配置
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Mail 配置
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Agent API 配置（可选）
AGENT_API_KEY=

# minio 配置
# App 的 API Key 现在保存在 file_app.api_key_hash（SHA-256 哈希），Bucket 由 file_policy 表配置，
# 均不再通过环境变量下发，见 docs/modules/file/schema.sql
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_DOMAIN=

# Druid 监控页面配置
DRUID_STAT_USERNAME=druid
DRUID_STAT_PASSWORD=

# 支付模块配置
# 渠道配置（如支付宝私钥）AES-GCM 加密主密钥，Base64 编码 16/24/32 字节，生成示例：openssl rand -base64 32
# 禁止写入代码仓库、禁止落库，只能通过环境变量下发；轮换需要重新加密全部 payment_channel_account.config_encrypted
PAYMENT_MASTER_KEY=
# 支付宝服务器能访问到的公网回调地址，如 https://cms.thxdxw.cn（不能填内网/容器内地址）
PAYMENT_PUBLIC_BASE_URL=