<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.thx</groupId>
    <artifactId>cms</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>cms</name>
    <description>内容管理系统</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!--
      统一版本管理：所有第三方依赖（非 Spring Boot 官方 starter）的版本号
      都集中声明在这里，dependencies 里通过 ${xxx.version} 引用，
      升级版本时只需要改这一处。
      spring-boot-starter-xxx / mysql-connector-j / lombok 等由父 POM
      spring-boot-starter-parent 统一管理版本，因此不需要在这里单独声明。
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>

        <!-- 数据库与连接池 -->
        <druid.version>1.2.24</druid.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>

        <!-- 认证鉴权与验证码 -->
        <sa-token.version>1.44.0</sa-token.version>
        <captcha.version>2.2.3</captcha.version>

        <!-- 存储与文件处理 -->
        <minio.version>8.5.17</minio.version>
        <tika.version>2.9.2</tika.version>

        <!-- 通用工具库 -->
        <hutool.version>5.8.22</hutool.version>
        <jsoup.version>1.21.1</jsoup.version>

        <!-- 支付宝官方 SDK：版本经 Maven Central 官方索引核实为核实时点最新稳定版 -->
        <alipay-sdk.version>4.40.272.ALL</alipay-sdk.version>
    </properties>

    <dependencies>
        <!--Web 基础依赖：Spring MVC + 内置 Tomcat，版本由父 POM 管理-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--WebSocket 支持：站内实时日志、在线人数等推送功能使用-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!--Thymeleaf 模板引擎：后台管理页面、主题页面渲染使用-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!--AOP 支持：Shiro 注解鉴权、自定义切面依赖-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!--Spring Data Redis：提供 RedisTemplate/连接工厂，缓存与会话共享使用-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--生成 @ConfigurationProperties 元数据，供 IDE 编写 yml 配置时自动提示-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
        </dependency>
        <!--Actuator：提供 /actuator/health 健康检查端点。
            部署脚本靠它判断新版本是否真正就绪（而不是只看容器进程还活着），
            健康检查失败时自动回滚到上一个镜像。默认只暴露 health 端点，见 application.yml-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--MySQL 驱动，版本由父 POM 管理-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!--Druid 数据库连接池：连接池管理 + SQL 防火墙 + 监控页面-->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>
        <!--Sa-Token：认证鉴权框架，提供登录态、会话、注解/路由鉴权与同账号登录数限制。
            2026-08 取代原先的 Apache Shiro + shiro-redis：换掉 Shiro 的直接原因不是它本体过时
            （3.0.0 已支持 Jakarta），而是其 Redis 生态 shiro-redis 早已停止维护——该库针对
            Jedis 3.3.0 编译，会把整个项目反向锁死在 2020 年的 Jedis 版本上，并与 Spring Boot 3
            的依赖管理持续冲突（曾导致会话创建抛 NoSuchMethodError、后台整体 500）。-->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!--Sa-Token 的 Redis 存储（Jackson 序列化）：登录态与会话共享到 Redis，支持多实例部署。
            底层复用项目已有的 spring-boot-starter-data-redis（Lettuce 客户端），不引入 Jedis-->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!--图形验证码：登录页面防暴力破解-->
        <dependency>
            <groupId>com.pig4cloud.plugin</groupId>
            <artifactId>captcha-core</artifactId>
            <version>${captcha.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>javax.servlet</groupId>
                    <artifactId>javax.servlet-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--MinIO 对象存储 SDK：com.thx.module.file 文件系统模块的存储实现-->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>
        <!--Apache Tika 真实文件类型检测（仅 tika-core，不需要完整 tika-parsers），
            文件系统模块上传校验时识别文件真实内容类型，防止伪造扩展名/Content-Type-->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <!--MyBatis-Plus：ORM 框架，简化 CRUD 与分页查询。spring-boot3 starter 适配 Spring Boot 3.x-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!--Hutool 工具库：字符串/集合/日期/文件名等常用工具方法。
            只引 hutool-core 而非 hutool-all：项目实际只用到 core 里的
            StrUtil/CollUtil/FileNameUtil/NumberUtil/MapUtil/BeanUtil/RandomUtil/Validator/DateUtil，
            原先 hutool-all 会把 http/crypto/poi 等全部模块打进来，体积大且扩大攻击面。
            原 HttpUtil 已改用 JDK 内置 HttpClient，HtmlUtil 已改用 jsoup（见 HtmlSanitizer）。-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
            <version>${hutool.version}</version>
        </dependency>
        <!--Spring Security 的独立加密模块：只提供 BCryptPasswordEncoder 等密码编码器，
            不包含 Spring Security 的过滤器链/自动配置，不会影响现有鉴权体系。
            用于把用户密码从不安全的 md5 加盐哈希迁移到 BCrypt，版本由父 POM 管理。-->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!--Jsoup：HTML 解析，爬虫抓取和富文本内容清洗使用-->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!--邮件发送：注册验证码、通知邮件，版本由父 POM 管理-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!--支付宝官方 SDK：payment 模块支付宝 Adapter 使用，签名/协议/HTTP 调用全部委托 SDK，不自行实现-->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>${alipay-sdk.version}</version>
        </dependency>


        <!--Lombok：编译期生成 Getter/Setter/构造器等样板代码，版本由父 POM 管理-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--Spring Boot 测试基础依赖（JUnit5 + Mockito + Spring Test），版本由父 POM 管理-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--固定产物名为 cms.jar：Dockerfile 与 deploy.sh 都按这个名字复制构建结果，
            改名会同时破坏镜像构建，需一并调整-->
        <finalName>cms</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--Lombok 只在编译期生成代码，不需要打进运行时 jar-->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
