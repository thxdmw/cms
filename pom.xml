<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.thx</groupId>
    <artifactId>cms-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>cms-parent</name>
    <description>内容管理系统 - Maven 模块化单体聚合工程（单 Jar、单容器部署）</description>

    <!--
      模块依赖方向（Maven 反应堆按此拓扑排序）：
        cms-app
          ├── cms-platform ──> cms-file ──> cms-kernel
          ├── cms-gamesave ──> cms-file
          └── cms-payment ────────────────> cms-kernel
      只有 cms-app 打可执行 Jar（spring-boot-maven-plugin），其余模块是普通 Jar。
    -->
    <modules>
        <module>cms-kernel</module>
        <module>cms-file</module>
        <module>cms-payment</module>
        <module>cms-gamesave</module>
        <module>cms-platform</module>
        <module>cms-app</module>
    </modules>

    <!--
      统一版本管理：所有第三方依赖（非 Spring Boot 官方 starter）的版本号
      都集中声明在这里，子模块 dependencies 里通过 dependencyManagement 引用，
      升级版本时只需要改这一处。
      spring-boot-starter-xxx / mysql-connector-j / lombok 等由父 POM
      spring-boot-starter-parent 统一管理版本，因此不需要在这里单独声明。
      注意：不要把依赖直接写进本 POM 的 <dependencies>——那样所有子模块都会
      继承全部依赖，破坏各模块只声明实际依赖的边界。
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>

        <!-- 数据库与连接池 -->
        <druid.version>1.2.24</druid.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>

        <!-- 认证鉴权与验证码 -->
        <sa-token.version>1.44.0</sa-token.version>
        <captcha.version>2.2.3</captcha.version>

        <!-- 存储与文件处理 -->
        <minio.version>8.5.17</minio.version>
        <tika.version>2.9.2</tika.version>

        <!-- 通用工具库 -->
        <hutool.version>5.8.22</hutool.version>
        <jsoup.version>1.21.1</jsoup.version>

        <!-- 支付宝官方 SDK：版本经 Maven Central 官方索引核实为核实时点最新稳定版 -->
        <alipay-sdk.version>4.40.272.ALL</alipay-sdk.version>

        <!--
          Windows 本地开发必需的两项 JVM 参数（对 Linux CI 无影响）：
          1. -Djdk.attach.allowAttachSelf=true：Corretto 21 在 Windows 上默认拒绝
             byte-buddy 内进程 self-attach，导致 Mockito 报 "Could not initialize
             plugin: interface org.mockito.plugins.MockMaker"；
          2. -Djdk.net.URLClassPath.disableClassPathURLCheck=true：JDK 21.0.2+ 默认
             拒绝 manifest Class-Path 含绝对路径的 jar（surefire booter 受影响）。
        -->
        <argLine>-Djdk.attach.allowAttachSelf=true -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块：子模块引用时无需写版本号 -->
            <dependency>
                <groupId>com.thx</groupId>
                <artifactId>cms-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thx</groupId>
                <artifactId>cms-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thx</groupId>
                <artifactId>cms-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thx</groupId>
                <artifactId>cms-gamesave</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.thx</groupId>
                <artifactId>cms-platform</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!--Druid 数据库连接池：连接池管理 + SQL 防火墙 + 监控页面。
                必须用 druid-spring-boot-3-starter 而不是 druid-spring-boot-starter：
                后者的自动配置只注册在 META-INF/spring.factories，而 Spring Boot 3 已改为读取
                META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports，
                因此在 Boot 3 下它的自动配置完全不会加载-->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!--Sa-Token：认证鉴权框架，提供登录态、会话、注解/路由鉴权与同账号登录数限制-->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!--Sa-Token 的 Redis 存储（Jackson 序列化）：登录态与会话共享到 Redis-->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!--图形验证码：登录页面防暴力破解-->
            <dependency>
                <groupId>com.pig4cloud.plugin</groupId>
                <artifactId>captcha-core</artifactId>
                <version>${captcha.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>javax.servlet</groupId>
                        <artifactId>javax.servlet-api</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!--MinIO 对象存储 SDK：cms-file 文件系统模块的存储实现-->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!--Apache Tika 真实文件类型检测（仅 tika-core）-->
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>${tika.version}</version>
            </dependency>
            <!--MyBatis-Plus：ORM 框架，简化 CRUD 与分页查询-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--MyBatis-Plus 扩展：kernel 的 Pagination 分页基类依赖-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-extension</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--Hutool 工具库：只引 hutool-core 而非 hutool-all-->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!--Jsoup：HTML 解析，爬虫抓取和富文本内容清洗使用-->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <!--支付宝官方 SDK：payment 模块支付宝 Adapter 使用-->
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>${alipay-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
